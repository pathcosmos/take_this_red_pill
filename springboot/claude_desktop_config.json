{
  "mcpServers": {
    "weather-springboot": {
      "command": "java",
      "args": [
        "-jar",
        "build/libs/mcp-server-0.0.1-SNAPSHOT.jar"
      ],
      "cwd": "/absolute/path/to/springboot",
      "env": {
        "OPENWEATHERMAP_API_KEY": "your_api_key_here",
        "JAVA_HOME": "/Library/Java/JavaVirtualMachines/zulu-21.jdk/Contents/Home"
      }
    }
  }
}
